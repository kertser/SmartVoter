DATABASE_URL=postgresql+psycopg://smartvoter:smartvoter@localhost:5432/smartvoter
REDIS_URL=redis://localhost:6379/0
APP_ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# Admin panel password — change this before any deployment
ADMIN_PASSWORD=admin

# LLM (optional — mock provider used when not set)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# uv virtual environment — must match the project's .venv directory
# Do NOT change this to "venv"; uv always uses ".venv" in this project.
VIRTUAL_ENV=.venv

# Production domain (used by run-prod.sh and Caddyfile)
DOMAIN=smartvoter.alpha-numerical.com

# Production DB credentials (override for production)
# POSTGRES_USER=smartvoter
# POSTGRES_PASSWORD=change-me-strong-password
# POSTGRES_DB=smartvoter

# Next.js: leave empty when using Caddy (same domain for frontend + API)
NEXT_PUBLIC_API_URL=

